# Copy to .env / Infisical. Do not commit secrets.
# Do not set NODE_ENV here — Next/Nest manage it (NODE_ENV in .env breaks `next build`).

# Postgres (compose maps host 5435 → container 5432)
DATABASE_URL=postgres://getpersona:getpersona@127.0.0.1:5435/getpersona
REDIS_URL=redis://127.0.0.1:6379

# API
API_PORT=3001
# TypeORM: sync schema in non-production by default; set false to disable
TYPEORM_SYNC=true
# Promote credential (header X-Promote-Credential). Separate from write/session (D-007).
# M5 will replace with hashed API keys; local default is fine for development only.
PROMOTE_CREDENTIAL=dev-only-promote-credential

# LLM — llm_wrapper gateway only (no direct model SDKs).
# If LLM_WRAPPER_URL is unset or unreachable, write agents use a deterministic stub
# that still returns valid {status: text|skip} for local/CI tests.
# LLM_WRAPPER_URL=http://127.0.0.1:8787
# LLM_WRAPPER_MODEL=coding-codex
# LLM_WRAPPER_TOKEN=  # or GATEWAY_SERVICE_TOKEN
# LLM_WRAPPER_TIMEOUT_MS=60000

BETTER_AUTH_URL=http://localhost:3001
# Min 32 chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret

# Cookie domain:
# - Local: leave unset (host-only cookie on the API origin; works with CORS + credentials)
# - Production: .getpersona.md (shared across getpersona.md / api.getpersona.md / agent.getpersona.md)
# AUTH_COOKIE_DOMAIN=.getpersona.md

# CORS / trusted origins (comma-separated). Local web default below.
WEB_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP stubs (local works without real mail; verification not required in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@getpersona.md
# Set true in production when SMTP is configured (getDesign.md parity)
REQUIRE_EMAIL_VERIFICATION=false

# OAuth stubs (enable when credentials present — getDesign.md parity)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
